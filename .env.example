# Токен от @BotFather. В репозиторий не коммитить!
TELEGRAM_BOT_TOKEN=

# Общий секрет: Telegram шлёт его в заголовке X-Telegram-Bot-Api-Secret-Token,
# им же защищён /api/setup. Сгенерировать: openssl rand -hex 32
WEBHOOK_SECRET=

# Необязательно. Если задан — картинки будут ссылаться на этот домен,
# иначе адрес берётся из заголовков запроса.
PUBLIC_URL=
