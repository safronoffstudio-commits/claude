# --- App -----------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Public URL without a trailing slash. Used for Stripe redirects, emails and the CSRF check.
APP_URL=https://hookcut.app
DATABASE_PATH=./data/hookcut.db
# Set to 1 behind a reverse proxy / PaaS so rate limits see the real client IP.
TRUST_PROXY=1
# Comma-separated emails that can open /admin.
ADMIN_EMAILS=you@example.com

# --- AI (Claude) ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max — quality vs. cost per generation.
AI_EFFORT=high
# Parallel generations per server process.
AI_CONCURRENCY=4
# 1 = offline demo generator, no API calls (default in development without a key).
AI_MOCK=0

# --- Billing (Stripe) -----------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Monthly recurring prices, one per paid plan.
STRIPE_PRICE_CREATOR=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...

# --- Email (password reset) ---------------------------------------------------
# Without a key, emails are printed to the server log.
RESEND_API_KEY=re_...
EMAIL_FROM=Hookcut <hello@hookcut.app>
